{
  "name": "@podlink/icons",
  "version": "0.2.0",
  "type": "module",
  "description": "Podcast platform icons and badges — framework-agnostic SVG strings + React components",
  "license": "MIT",
  "homepage": "https://github.com/TeamPodlink/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamPodlink/icons.git"
  },
  "bugs": {
    "url": "https://github.com/TeamPodlink/icons/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./static/*": "./static/*"
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "static/icons",
    "static/badges",
    "CHANGELOG.md"
  ],
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build:static": "tsx scripts/build-static.ts",
    "build:lib": "tsup",
    "build": "pnpm codegen && pnpm build:static && pnpm build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist src/generated static/icons static/badges",
    "validate": "tsx scripts/validate-icons.ts",
    "lint": "eslint src scripts",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'scripts/**/*.ts' '*.config.*'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'scripts/**/*.ts' '*.config.*'",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fontsource/inter": "^5.2.8",
    "@testing-library/react": "^16.1.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^25.0.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svgo": "^3.3.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.55.0",
    "vitest": "^2.1.0"
  }
}
