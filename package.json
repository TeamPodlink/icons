{
  "name": "refraction-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Podcast platform icons, badges, and Liquid Glass — directory site, npm packages, and shadcn registry.",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "assets": "node pipeline/build-assets.mjs",
    "release:assets": "node pipeline/upload-assets.mjs",
    "registry": "node pipeline/build-registry.mjs",
    "validate": "node pipeline/validate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "sharp": "^0.34.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
